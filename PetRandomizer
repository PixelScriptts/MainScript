-- Pet rarity color
local function getPetRarityColor(petName)
    if petName:find("%(Divine%)") then
        return Color3.fromRGB(255, 215, 0), false
    end

    if petName:find("%(Prismatic%)") then
        return prismaticColors[1], true
    end

    return Color3.fromRGB(255, 85, 85), false
end

-- Animate Prismatic text
local function animatePrismatic(label)
    task.spawn(function()

        local index = 1

        while label and label.Parent do

            local nextIndex = index + 1
            if nextIndex > #prismaticColors then
                nextIndex = 1
            end

            local tween = TweenService:Create(
                label,
                TweenInfo.new(0.5, Enum.EasingStyle.Linear),
                {TextColor3 = prismaticColors[nextIndex]}
            )

            tween:Play()
            tween.Completed:Wait()

            index = nextIndex
        end
    end)
end

-- Weighted random pet selector
local function getRandomPet(eggName)
    local pets = eggChances[eggName]
    if not pets then return "Unknown" end
    local totalChance = 0
    for _, pet in ipairs(pets) do
        totalChance += pet.chance
    end
    local roll = math.random() * totalChance
    local sum = 0
    for _, pet in ipairs(pets) do
        sum += pet.chance
        if roll <= sum then
            return pet.name
        end
    end
    return pets[#pets].name
end

